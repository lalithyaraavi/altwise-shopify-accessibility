# Copy this file to .env and fill in your own values (from the Shopify Dev Dashboard)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
# Dev stores are password-protected: Shopify admin > Online Store > Preferences
STOREFRONT_PASSWORD=your-storefront-password
